{
  "name": "@pulse-rn/desktop",
  "version": "1.0.4",
  "description": "PulseRN Electron desktop debugger.",
  "author": "PulseRN contributors",
  "homepage": "https://github.com/maahibhama/PulseRN",
  "desktopName": "dev.pulsern.desktop.desktop",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "prebuild": "pnpm --filter @pulse-rn/mcp build",
    "build": "electron-vite build",
    "predev": "pnpm --filter @pulse-rn/mcp build",
    "dev": "electron-vite dev",
    "dist": "pnpm build && electron-builder",
    "dist:linux": "pnpm build && electron-builder --linux AppImage deb --x64",
    "dist:mac": "pnpm build && electron-builder --mac dmg --arm64 --x64 -c.mac.identity=null -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "dist:win:arm64": "pnpm build && electron-builder --win nsis --arm64",
    "dist:win:x64": "pnpm build && electron-builder --win nsis --x64",
    "lint": "eslint src",
    "pack": "pnpm build && electron-builder --dir -c.mac.identity=null -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:e2e": "pnpm build && node test/e2e/electron-smoke.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@monaco-editor/react": "^4.7.0",
    "@pulse-rn/api-contract": "workspace:*",
    "@pulse-rn/mcp": "workspace:*",
    "@pulse-rn/protocol": "workspace:*",
    "@pulse-rn/shared": "workspace:*",
    "electron-updater": "6.8.9",
    "monaco-editor": "^0.52.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/react": "19.0.14",
    "@types/react-dom": "19.0.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "vite": "^7.1.1"
  },
  "build": {
    "appId": "dev.pulsern.desktop",
    "productName": "PulseRN",
    "copyright": "Copyright © 2026 PulseRN contributors",
    "asar": true,
    "electronUpdaterCompatibility": ">=2.16",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/pulse-rn-app-icon-dark.png",
      "resources/pulse-rn-app-icon-light.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../packages/mcp/dist",
        "to": "mcp",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "PulseRN-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "PulseRN ${version}",
      "icon": "resources/icon.icns",
      "backgroundColor": "#0b0d12",
      "contents": [
        {
          "x": 140,
          "y": 220
        },
        {
          "x": 400,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "PulseRN-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PulseRN"
    },
    "linux": {
      "category": "Development",
      "executableName": "pulsern",
      "icon": "resources/pulse-rn-app-icon-light.png",
      "maintainer": "PulseRN contributors",
      "synopsis": "React Native desktop debugger",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "PulseRN-${version}-linux-x64.${ext}"
    },
    "deb": {
      "artifactName": "PulseRN-${version}-linux-x64.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "maahibhama",
      "repo": "PulseRN"
    }
  }
}
