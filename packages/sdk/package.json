{
  "name": "@pulse-rn/sdk",
  "version": "0.1.0",
  "description": "Development-only React Native client for PulseRN.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.native.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pulse-rn/protocol": "workspace:*",
    "@pulse-rn/shared": "workspace:*"
  }
}
