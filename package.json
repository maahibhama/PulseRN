{
  "name": "pulse-rn",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source React Native debugging and performance monitoring desktop tool.",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:desktop": "pnpm --filter @pulse-rn/desktop dev",
    "dist:desktop": "pnpm --filter @pulse-rn/desktop run dist",
    "dist:linux": "pnpm --filter @pulse-rn/desktop run dist:linux",
    "dist:mac": "pnpm --filter @pulse-rn/desktop run dist:mac",
    "dist:win:arm64": "pnpm --filter @pulse-rn/desktop run dist:win:arm64",
    "dist:win:x64": "pnpm --filter @pulse-rn/desktop run dist:win:x64",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "pack:desktop": "pnpm --filter @pulse-rn/desktop run pack",
    "release:desktop": "node scripts/release.mjs",
    "release:verify": "node scripts/verify-release-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
